Group {
 name CG_LensFX
 help "Apply lens effects to your comped CG.\n\n\noriginal gizmo (c) marian-m 2013 \nfurther developement filip-s"
 tile_color 0x4bff4bff
 xpos -2117
 ypos -4392
 addUserKnob {20 CG l CG_LensEffects}
 addUserKnob {4 alpha l mask M {"use source alpha" "use mask input" "apply to the entire image (full CG shots only)" "" "" ""}}
 addUserKnob {6 apply l INVISIBLE +INVISIBLE +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {6 envClamp l "Fix super bright BG" t "Can help when the BG has values above 1 and it's overpowering the FG with glow" +STARTLINE}
 addUserKnob {41 which l "Diffuse amount" T Diffuse_amount.which}
 addUserKnob {7 diffQual l "Diffuse quality" R 0.05 1}
 diffQual 0.2
 addUserKnob {26 diffSclaimer l "" +STARTLINE T "This is a very heavy operation, 0.2 quality will work fine in most cases."}
 addUserKnob {26 ""}
 addUserKnob {41 mix l "Bloom amount" T Bloom.mix}
 addUserKnob {41 size l "Edge blur size" T Edgeblur.size}
 addUserKnob {26 ""}
 addUserKnob {41 which_1 l "LensHaze amount" T Lenshaze.which}
 addUserKnob {20 haze_colours l "LensHaze colour controls" -STARTLINE n 1}
 addUserKnob {26 haze_info l "" +STARTLINE T "Default LensHaze colour is based on the BG and it will work fine\nmost of the time. Tweak the colour here if needed."}
 addUserKnob {41 saturation l "LensHaze saturation" T Saturation1.saturation}
 addUserKnob {41 value l "LensHaze colour" T haze_Multiply.value}
 addUserKnob {20 endGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {41 RedAberration_1 l "Red aberration" +INVISIBLE T Transform1.RedAberration}
 addUserKnob {41 RedAberration l "Green aberration" +INVISIBLE T Transform2.RedAberration}
 addUserKnob {26 ""}
 addUserKnob {41 which_2 l mix T Dissolve1.which}
}
